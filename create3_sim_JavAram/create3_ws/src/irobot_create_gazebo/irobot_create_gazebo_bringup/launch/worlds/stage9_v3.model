<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- OUTER WALLS 6x6 -->
    <model name='outer_walls_6x6'>
      <pose>0 0 0 0 0 0</pose>

      <link name='Wall_L'>
        <collision name='c'>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
        </visual>
        <pose>-3 0 0 0 0 1.5708</pose>
      </link>

      <link name='Wall_T'>
        <collision name='c'>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0 3 0 0 0 0</pose>
      </link>

      <link name='Wall_R'>
        <collision name='c'>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
        </visual>
        <pose>3 0 0 0 0 -1.5708</pose>
      </link>

      <link name='Wall_B'>
        <collision name='c'>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>6 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0 -3 0 0 0 3.14159</pose>
      </link>

      <static>1</static>
    </model>

    <!-- INNER WALLS 6x6 -->
    <model name='inner_walls_6x6'>
      <pose>0 0 0 0 0 0</pose>

      <!-- Entrada -->
      <link name='Entry'>
        <collision name='c'>
          <geometry><box><size>2 0.15 0.5</size></box></geometry>
          <pose>0 0.25 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>2.9 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0 -1.6 0 0 0 1.57</pose>
      </link>

      <!-- Pasillo -->
      <link name='Hallway'>
        <collision name='c'>
          <geometry><box><size>2.5 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>2.5 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0.45 -1 0 0 0 0</pose>
      </link>

      <!-- Salón -->
      <link name='Living_1'>
        <collision name='c'>
          <geometry><box><size>2 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>2 0.15 0.5</size></box></geometry>
        </visual>
        <pose>-1.5 2 0 0 0 1.5708</pose>
      </link>

      <link name='Living_2'>
        <collision name='c'>
          <geometry><box><size>1.5 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>2 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0.8 1.8 0 0 0 0</pose>
      </link>

      <!-- Habitación -->
      <link name='Bedroom'>
        <collision name='c'>
          <geometry><box><size>1.25 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.3 0.15 0.5</size></box></geometry>
        </visual>
        <pose>1.63 -0.3 0 0 0 1.5708</pose>
      </link>

      <!-- Baño -->
      <!--<link name='Bathroom'>
        <collision name='c'>
          <geometry><box><size>1.2 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='v'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.2 0.15 0.5</size></box></geometry>
        </visual>
        <pose>-2 0.2 0 0 0 0</pose>
      </link>-->

      <static>1</static>
    </model>

  </world>
</sdf>
