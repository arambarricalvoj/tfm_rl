<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <!-- suelo plano estándar de Gazebo -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- luz principal del mundo -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- desactivar sombras para mejorar el rendimiento (en este proyecto las sombras no aportan nada) -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- cámara principal que se ve al abrir Gazebo -->
    <!-- orbit: cámara que gira alrededor del punto de interés ?? --> 
    <!-- pose: posición y orientación de la cámara -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  <!-- física del mundo -->
    <physics type="ode">

    <!-- parámetros típicos para RL, requieren alta precisión física, simulación estable y tiempo de integración pequeños -->
      <real_time_update_rate>1000.0</real_time_update_rate> <!-- Hz. 1000 pasos por segundo -->
      <max_step_size>0.001</max_step_size> <!-- cada paso de simulación dura 0.001 s (1 ms) -->
      <real_time_factor>1</real_time_factor> <!-- simulación intenta correr en tiempo real ?? --> 

      <ode> <!-- parámetros del motor físico -->
        <solver>
          <type>quick</type> <!-- solver rápido de ODE -->
          <iters>150</iters> <!-- más iteraciones más precisión en contactos -->
          <precon_iters>0</precon_iters> ??
          <sor>1.400000</sor> <!-- parámetro de relajación de convergencia ?? -->
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints> <!-- rigidez de uniones y contactos ?? -->
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://turtlebot3_drl_world/outer_walls_large</uri>
    </include>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://turtlebot3_drl_world/inner_walls_large</uri>
    </include>

  <!-- obstáculos dinámicos con plugins -->
    <model name="turtlebot3_drl_obstacle1">
      <plugin name="obstaclelarge1" filename="libobstacle7.so"/>
      <include>
        <pose>2 2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle1</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle2">
      <plugin name="obstaclelarge2" filename="libobstacle8.so"/>
      <include>
        <pose>-2 -2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle2</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle3">
      <plugin name="obstaclelarge3" filename="libobstacle9.so"/>
      <include>
        <pose>2 -2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle3</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle4">
      <plugin name="obstaclelarge4" filename="libobstacle10.so"/>
      <include>
        <pose>-2 2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle4</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle5">
      <plugin name="obstaclelarge5" filename="libobstacle11.so"/>
      <include>
        <pose>0 -2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle5</uri>
      </include>
    </model>

    <model name="turtlebot3_drl_obstacle6">
      <plugin name="obstaclelarge6" filename="libobstacle12.so"/>
      <include>
        <pose>0 2 0 0 0 0</pose>
        <uri>model://turtlebot3_drl_world/obstacle6</uri>
      </include>
    </model>

  </world>
</sdf>
