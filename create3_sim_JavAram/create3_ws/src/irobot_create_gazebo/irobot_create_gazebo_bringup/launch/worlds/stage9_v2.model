          <geometry><box><size>10 0.15 0.5</size></box></geometry>
        </visual>
        <pose>5 0 0 0 0 -1.5708</pose>
      </link>

      <!-- BOTTOM WALL -->
      <link name='Wall_4'>
        <collision name='Wall_4_Collision'>
          <geometry><box><size>10 0.15 0.5</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='Wall_4_Visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>10 0.15 0.5</size></box></geometry>
        </visual>
        <pose>0 -5 0 0 0 3.14159</pose>
      </link>

      <static>1</static>
    </model>

